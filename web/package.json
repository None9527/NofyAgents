{
  "name": "grok-build-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Grok Build client — web-first UI, Electron-ready (see electron/ for phase 2)",
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron . --no-sandbox --remote-allow-origins=*",
    "desktop:view": "electron . --no-sandbox --remote-allow-origins=* --remote-debugging-port=9223"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
