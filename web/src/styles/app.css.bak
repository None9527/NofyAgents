/* Main-screen styles — ported from ref-ui client-clean (palette sampled from
   the reference capture). Dark by default; [data-theme="light"] overrides. */

:root {
  --bg: #161616;
  --bg-sidebar: #2b2b2b;
  --bg-card-outer: #212121;
  --bg-card-inner: #2b2b2b;
  --border-card: #4a4a4a;
  --border-soft: #2d2d2d;
  --text: #e8e8e8;
  --text-mid: #cfcfcf;
  --text-low: #8a8a8a;
  --text-faint: #6f6f6f;
  --placeholder: #5e5e5e;
}

* { box-sizing: border-box; }
html, body, #root { margin: 0; height: 100%; }
body {
  background: var(--bg);
  color: var(--text);
  font: 13px/1.5 ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
}

.shell { display: flex; height: 100%; }

/* ---------------- sidebar ---------------- */
.sidebar {
  width: 265px;
  flex: none;
  background: var(--bg-sidebar);
  display: flex;
  flex-direction: column;
  padding: 14px 12px 12px;
}
.sidebar-logo { display: flex; align-items: center; gap: 12px; padding: 0 4px 18px; }
.logo-badge {
  width: 26px; height: 26px; border-radius: 7px;
  background: #0d0d0d; color: #fff; font-weight: 700; font-size: 15px;
  display: inline-flex; align-items: center; justify-content: center;
  font-family: Georgia, serif;
}
.nav-arrows { color: var(--text-faint); letter-spacing: 6px; font-size: 12px; }

.nav { display: flex; flex-direction: column; gap: 2px; }
.nav-item {
  display: flex; align-items: center; gap: 10px;
  height: 36px; padding: 0 8px; border-radius: 6px;
  color: var(--text-mid); cursor: pointer;
}
.nav-item:hover { background: #333; }
.nav-item em {
  margin-left: auto; font-style: normal; font-size: 11px; color: var(--text-faint);
}

.group-row {
  margin-top: 4px;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 2px;
}
.segment {
  display: inline-flex; align-items: center; gap: 2px;
  background: #3d3d3d; border-radius: 999px; padding: 2px;
}
.seg {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 12px; color: var(--text-low);
  padding: 3px 10px; border-radius: 999px;
}
.seg.active { background: #141414; color: var(--text-mid); border: 1px solid #4a4a4a; }
.seg-extra { color: var(--text-faint); margin-left: 6px; }
.row-actions { display: inline-flex; gap: 10px; color: var(--text-low); align-items: center; }
.row-actions.right { margin-left: auto; }
.row-actions span { cursor: pointer; }

.section { margin-top: 14px; }
.section-head {
  display: flex; justify-content: space-between; align-items: center;
  color: var(--text-low); font-size: 12px; padding: 0 4px;
}
.section-head span:first-child { display: inline-flex; gap: 4px; align-items: center; }
.workspace-row {
  display: flex; gap: 8px; align-items: center;
  padding: 7px 6px; color: var(--text-mid);
}
.session-row {
  display: flex; justify-content: space-between;
  padding: 6px 6px 6px 28px; color: var(--text-mid); cursor: pointer;
}
.session-row:hover { background: #333; border-radius: 6px; }
.session-row em { font-style: normal; font-size: 11px; color: var(--text-faint); }
.empty { padding: 8px 6px; color: var(--text-faint); font-size: 12px; }

.sidebar-footer {
  margin-top: auto; display: flex; align-items: center; gap: 8px;
  padding: 6px 4px 0;
}
.avatar {
  width: 24px; height: 24px; border-radius: 50%;
  background: #3a3a3a; color: var(--text-mid);
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 12px;
}
.user { color: var(--text-mid); }

/* ---------------- main ---------------- */
.main { flex: 1; display: flex; flex-direction: column; min-width: 0; overflow-y: auto; }
.titlebar {
  height: 40px; display: flex; align-items: center; justify-content: flex-end;
  gap: 18px; padding: 0 14px; color: var(--text-mid); flex: none;
}
.tb-left { margin-right: auto; display: inline-flex; cursor: pointer; }
.tb-right { display: inline-flex; gap: 18px; align-items: center; }
.tb-right > span { cursor: pointer; }
.tb-chevron {
  border-left: 1px solid var(--border-soft);
  padding-left: 16px; display: inline-flex;
}

.hero { display: flex; flex-direction: column; align-items: center; margin-top: 6px; }
.hero-mark { opacity: 0.9; }
.hero h1 { font-size: 24px; font-weight: 600; margin: 54px 0 0; color: var(--text); }

.composer { display: flex; flex-direction: column; align-items: center; }
.composer-card {
  width: 675px; margin-top: 32px;
  background: var(--bg-card-outer); border-radius: 12px;
  padding: 8px 10px 10px;
}
.workspace-chip {
  display: flex; gap: 7px; align-items: center;
  color: var(--text-mid); padding: 6px 6px 8px; cursor: pointer;
}
.git-chip { font-size: 11px; color: var(--text-faint); border: 1px solid var(--border-soft); border-radius: 999px; padding: 1px 8px; }
.composer-inner {
  background: var(--bg-card-inner);
  border: 1px solid var(--border-card);
  border-radius: 10px;
  padding: 12px 14px 10px;
}
.composer-toolbar {
  margin-top: 22px; display: flex; align-items: center; justify-content: space-between;
}
.tool-left, .tool-right { display: inline-flex; align-items: center; gap: 14px; }
.tool { display: inline-flex; align-items: center; gap: 6px; color: var(--text-mid); cursor: pointer; }
.send {
  width: 28px; height: 28px; border-radius: 8px;
  background: #959595; color: #1c1c1c;
  display: inline-flex; align-items: center; justify-content: center;
  cursor: pointer;
}
.send:hover { background: #b0b0b0; }

.banner {
  width: 780px; margin-top: 28px;
  display: flex; align-items: center; gap: 8px;
  color: var(--text-low); font-size: 12px;
}
.banner-close { margin-left: auto; cursor: pointer; }

.suggestions { width: 779px; display: flex; gap: 16px; margin-top: 15px; }
.suggestion {
  flex: 1; border: 1px solid var(--border-soft); border-radius: 8px;
  padding: 12px 14px; min-height: 83px; cursor: pointer;
}
.suggestion:hover { border-color: var(--border-card); }
.suggestion-title { display: flex; gap: 7px; align-items: center; color: var(--text-mid); }
.suggestion-body { margin-top: 8px; color: var(--text-low); font-size: 12px; }

/* ---------------- task view ---------------- */
.task-view { flex: 1; display: flex; flex-direction: column; min-height: 0; }
.task-head {
  display: flex; align-items: center; gap: 12px;
  padding: 6px 10px; color: var(--text);
}
.back { cursor: pointer; color: var(--text-low); }
.task-title { font-size: 14px; }
.task-status { color: var(--text-faint); font-size: 12px; }
.task-actions { margin-left: auto; display: inline-flex; gap: 6px; }
.task-scroll { flex: 1; overflow-y: auto; padding: 12px 24px; }
.turn { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
.bubble {
  border-radius: 10px; padding: 10px 14px;
  white-space: pre-wrap; font-size: 13px; max-width: 720px;
}
.bubble.user { background: #232f3f; color: var(--text); align-self: flex-end; }
.bubble.assistant { background: #232323; border: 1px solid var(--border-soft); color: var(--text-mid); }
.bubble.thought {
  background: transparent; border: 1px dashed var(--border-soft);
  color: var(--text-faint); font-size: 12px; font-style: italic;
}

.composer-input {
  width: 100%;
  background: transparent;
  border: none;
  outline: none;
  color: var(--text-mid);
  font: inherit;
  min-height: 22px;
  padding: 0;
}
.composer-input::placeholder { color: var(--placeholder); }

/* markdown-lite */
.md-h { font-weight: 600; margin: 6px 0 2px; color: var(--text); }
.md-gap { height: 8px; }
.md-code {
  background: #1a1a1a; border: 1px solid var(--border-soft);
  border-radius: 6px; padding: 8px 10px; margin: 6px 0;
  white-space: pre-wrap; font-family: ui-monospace, monospace; font-size: 12px;
}
.md-table { border: none; background: transparent; padding: 0; }

/* task follow-up composer */
.task-composer {
  display: flex; gap: 10px; align-items: center;
  padding: 10px 18px; border-top: 1px solid var(--border-soft);
}
.task-composer .composer-input { flex: 1; }

/* dropdown menus */
.workspace-chip, .tool { position: relative; }
.menu {
  position: absolute; top: 100%; left: 0; z-index: 30;
  background: #232323; border: 1px solid var(--border-soft);
  border-radius: 8px; padding: 6px; min-width: 180px;
  box-shadow: 0 8px 24px rgba(0,0,0,.4);
}
.menu-item { padding: 6px 10px; border-radius: 6px; color: var(--text-mid); cursor: pointer; }
.menu-item:hover { background: #333; }
.menu-title { padding: 4px 10px; color: var(--text-faint); font-size: 11px; }
.menu-group + .menu-group { border-top: 1px solid var(--border-soft); margin-top: 4px; padding-top: 4px; }
.tool-right .menu { left: auto; right: 0; }

/* search overlay */
.overlay {
  position: fixed; inset: 0; z-index: 50;
  background: rgba(0,0,0,.5);
  display: flex; justify-content: center; align-items: flex-start; padding-top: 120px;
}
.overlay-panel {
  width: 560px; background: #232323; border: 1px solid var(--border-soft);
  border-radius: 12px; overflow: hidden;
}
.overlay-input-row { display: flex; gap: 10px; align-items: center; padding: 12px 14px; border-bottom: 1px solid var(--border-soft); color: var(--text-low); }
.overlay-results { max-height: 320px; overflow-y: auto; padding: 6px; }
.overlay-item { display: flex; gap: 10px; align-items: center; padding: 8px 10px; border-radius: 6px; color: var(--text-mid); cursor: pointer; }
.overlay-item:hover { background: #333; }

/* generic list / settings views */
.list-view { flex: 1; display: flex; flex-direction: column; min-height: 0; }
.list-row { display: flex; gap: 10px; align-items: baseline; padding: 8px 4px; color: var(--text-mid); }
.list-name { font-size: 13px; }
.list-meta { color: var(--text-faint); font-size: 12px; }
.settings-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 4px; border-bottom: 1px solid var(--border-soft); }
.settings-label { color: var(--text-mid); }
.settings-value { color: var(--text-faint); font-size: 12px; max-width: 480px; }
.settings-select { background: #2b2b2b; color: var(--text-mid); border: 1px solid var(--border-soft); border-radius: 6px; padding: 4px 8px; }
.settings-group-title { margin: 18px 0 6px; color: var(--text-faint); font-size: 12px; }
.settings-button { background: #2b2b2b; color: var(--text-mid); border: 1px solid var(--border-soft); border-radius: 6px; padding: 5px 12px; cursor: pointer; }
.settings-button:hover { background: #333; }

/* agent tool blocks */
.tool-block {
  border: 1px solid var(--border-soft); border-radius: 8px;
  padding: 8px 10px; background: #1d1d1d; max-width: 760px;
}
.tool-name { color: #7fb069; font-size: 12px; font-family: ui-monospace, monospace; }
.tool-output { margin: 6px 0 0; color: var(--text-low); font-size: 11px; white-space: pre-wrap; font-family: ui-monospace, monospace; }

/* slash command palette */
.composer-inner { position: relative; }
.cmd-menu {
  position: absolute; left: 0; right: 0; bottom: calc(100% + 4px); z-index: 40;
  background: #232323; border: 1px solid var(--border-soft); border-radius: 8px;
  padding: 6px; max-height: 240px; overflow-y: auto;
  box-shadow: 0 8px 24px rgba(0,0,0,.4);
}
.shell[data-theme="light"] .cmd-menu { background: #fff; }
.cmd-menu .menu-item { display: flex; gap: 10px; align-items: baseline; }
.cmd-name { font-family: ui-monospace, monospace; color: #7fb069; }
.cmd-desc { color: var(--text-faint); font-size: 12px; }

/* stop button + offline banner */
.stop {
  width: 28px; height: 28px; border-radius: 8px;
  background: #5a2b2b; color: #ffb4b4; font-size: 12px;
  display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
}
.offline-banner {
  margin: 0 14px 8px; padding: 6px 12px; border-radius: 8px;
  background: #3a2b1c; border: 1px solid #6b4a2a; color: #e0b04c; font-size: 12px;
}
.bubble.streaming::after { content: "▍"; color: var(--text-faint); animation: blink 1s steps(2) infinite; }
@keyframes blink { 50% { opacity: 0; } }

/* plan mode / approval */
.tool.plan-on { color: #7fb069; border: 1px solid #7fb069; border-radius: 6px; padding: 2px 8px; }
.approve-row { padding: 8px 0; }
.approve-buttons { display: flex; gap: 8px; margin-top: 8px; }

/* terminal / browser / toast */
.terminal-scroll { font-family: ui-monospace, monospace; font-size: 12px; }
.terminal-line { margin: 0 0 4px; white-space: pre-wrap; color: var(--text-mid); }
.browser-frame { flex: 1; margin: 10px 16px; border: 1px solid var(--border-soft); border-radius: 8px; overflow: hidden; display: flex; }
.browser-iframe { width: 100%; height: 100%; border: none; background: #fff; }
.toast {
  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
  background: #232323; border: 1px solid var(--border-soft); color: var(--text-mid);
  border-radius: 8px; padding: 8px 16px; z-index: 60;
}

/* light theme */
.shell[data-theme="light"] {
  --bg: #f5f5f5; --bg-sidebar: #ececec; --bg-card-outer: #e4e4e4; --bg-card-inner: #ececec;
  --border-card: #c8c8c8; --border-soft: #d5d5d5; --text: #1a1a1a; --text-mid: #333;
  --text-low: #666; --text-faint: #999; --placeholder: #9a9a9a;
}
.shell[data-theme="light"] .logo-badge { background: #1a1a1a; }
.shell[data-theme="light"] .bubble.assistant,
.shell[data-theme="light"] .tool-block,
.shell[data-theme="light"] .md-code,
.shell[data-theme="light"] .menu,
.shell[data-theme="light"] .overlay-panel,
.shell[data-theme="light"] .toast { background: #fff; }
.shell[data-theme="light"] .bubble.user { background: #d8e4f2; }
.shell[data-theme="light"] .seg.active { background: #fff; }
.shell[data-theme="light"] .segment { background: #d0d0d0; }
.shell[data-theme="light"] .nav-item:hover,
.shell[data-theme="light"] .session-row:hover,
.shell[data-theme="light"] .menu-item:hover,
.shell[data-theme="light"] .overlay-item:hover { background: #ddd; }
.shell[data-theme="light"] .settings-button,
.shell[data-theme="light"] .settings-select { background: #f0f0f0; }

/* usage / summary / mcp */
.usage-chip {
  font-size: 11px; color: var(--text-faint);
  border: 1px solid var(--border-soft); border-radius: 999px; padding: 1px 8px;
  font-family: ui-monospace, monospace;
}
.turn-summary {
  margin: 4px 0 12px; color: var(--text-faint); font-size: 12px; font-style: italic;
  border-left: 2px solid var(--border-soft); padding-left: 10px;
}
.mcp-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 6px; background: #666; }
.mcp-dot.status-ok { background: var(--status-running); }
.mcp-dot.status-bad { background: var(--status-failed); }

/* browser tabs */
.browser-tabs { display: inline-flex; gap: 4px; align-items: center; margin-left: 12px; overflow-x: auto; }
.browser-tab {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 3px 10px; border-radius: 6px 6px 0 0;
  background: var(--bg-card-outer); color: var(--text-low);
  font-size: 12px; cursor: pointer; max-width: 160px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.browser-tab.active { background: var(--bg-card-inner); color: var(--text-mid); border: 1px solid var(--border-soft); }
.browser-tab-close { display: inline-flex; color: var(--text-faint); }
.browser-tab-close:hover { color: var(--text); }
.browser-tab-add { display: inline-flex; padding: 3px 6px; color: var(--text-low); cursor: pointer; }

/* files view */
.files-path {
  margin-left: 12px; color: var(--text-faint); font-size: 11px;
  font-family: ui-monospace, monospace; max-width: 480px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.files-body { flex: 1; display: flex; min-height: 0; }
.files-tree {
  width: 300px; flex: none; overflow-y: auto;
  border-right: 1px solid var(--border-soft); padding: 8px 6px;
}
.files-row {
  display: flex; gap: 8px; align-items: center;
  padding: 4px 8px; border-radius: 6px; color: var(--text-mid); cursor: pointer;
  font-size: 12px;
}
.files-row:hover { background: #333; }
.shell[data-theme="light"] .files-row:hover { background: #ddd; }
.files-icon { width: 14px; text-align: center; color: var(--text-faint); }
.files-viewer { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.files-viewer-head {
  display: flex; gap: 8px; align-items: center;
  padding: 6px 12px; color: var(--text-mid); font-size: 12px;
  border-bottom: 1px solid var(--border-soft);
}
.files-viewer-close { margin-left: auto; cursor: pointer; color: var(--text-faint); }
.files-content {
  flex: 1; margin: 0; overflow: auto; padding: 12px;
  font: 12px/1.5 ui-monospace, monospace; color: var(--text-mid);
  white-space: pre-wrap;
}

/* collapsible thought / tool blocks / copy */
details.tool-block { padding: 0; }
details.tool-block summary {
  list-style: none; cursor: pointer; padding: 8px 10px;
}
details.tool-block summary::-webkit-details-marker { display: none; }
details.tool-block[open] summary { border-bottom: 1px solid var(--border-soft); }
details.tool-block .tool-output { padding: 8px 10px; }
.thought-wrap summary {
  cursor: pointer; color: var(--text-faint); font-size: 12px;
  padding: 2px 0; user-select: none;
}
.bubble { position: relative; }
.bubble-copy {
  position: absolute; top: 6px; right: 8px;
  color: var(--text-faint); cursor: pointer; font-size: 12px; opacity: 0;
  transition: opacity .15s;
}
.bubble:hover .bubble-copy { opacity: 1; }
.bubble-copy:hover { color: var(--text); }

/* ---------- rich chat surface ---------- */
.home-composer { width: 675px; max-width: calc(100vw - 320px); }
.home-composer .composer-card { margin-top: 10px; }
.composer-card { width: 100%; }
textarea.composer-input { display: block; overflow-y: auto; }

.md-p { margin: 2px 0; }
.md-h { font-weight: 600; color: var(--text); margin: 8px 0 4px; }
.md-h1 { font-size: 17px; } .md-h2 { font-size: 15px; } .md-h3 { font-size: 14px; } .md-h4 { font-size: 13px; }
.md-hr { border-top: 1px solid var(--border-soft); margin: 8px 0; }
.md-inline-code {
  background: #1a1a1a; border: 1px solid var(--border-soft); border-radius: 4px;
  padding: 0 5px; font-family: ui-monospace, monospace; font-size: 12px; color: #e0b04c;
}
.shell[data-theme="light"] .md-inline-code { background: #f0f0f0; color: #8a5a00; }
.md-codeblock { border: 1px solid var(--border-soft); border-radius: 8px; margin: 6px 0; overflow: hidden; }
.md-codeblock-head {
  display: flex; justify-content: space-between; align-items: center;
  background: #191919; padding: 4px 10px;
  color: var(--text-faint); font-size: 11px; font-family: ui-monospace, monospace;
}
.shell[data-theme="light"] .md-codeblock-head { background: #e8e8e8; }
.md-copy { cursor: pointer; }
.md-copy:hover { color: var(--text); }
.md-codeblock .md-code { margin: 0; border: none; border-radius: 0; background: #141414; }
.shell[data-theme="light"] .md-codeblock .md-code { background: #fafafa; }
.md-list { margin: 4px 0; padding-left: 22px; }
.md-list li { margin: 2px 0; }
.md-quote {
  border-left: 3px solid var(--border-card); padding: 2px 10px;
  color: var(--text-low); margin: 6px 0;
}
table.md-table { border-collapse: collapse; margin: 6px 0; font-size: 12px; }
.md-table th, .md-table td { border: 1px solid var(--border-soft); padding: 4px 10px; }
.md-table th { color: var(--text); background: #1d1d1d; }
.shell[data-theme="light"] .md-table th { background: #eee; }
.md-table a, .md-p a { color: var(--color-sky-400, #38bdf8); }

.msg { display: flex; flex-direction: column; gap: 3px; }
.user-side { align-items: flex-end; }
.assistant-side { align-items: flex-start; }
.msg-meta { color: var(--text-faint); font-size: 10px; padding: 0 4px; }
.tool-status { display: inline-block; width: 14px; color: #7fb069; }
.tool-status.run { color: var(--status-awaiting); animation: blink 1s steps(2) infinite; }
.task-status.st-running { color: var(--status-running); }
.task-status.st-awaiting-approval { color: var(--status-awaiting); }
.task-status.st-failed { color: var(--status-failed); }
.stop-button { color: #ffb4b4; border-color: #6b3a3a; }
.send-busy { background: #5a5a5a; }

.scroll-bottom {
  position: absolute; right: 24px; bottom: 110px; z-index: 20;
  width: 32px; height: 32px; border-radius: 50%;
  background: #2b2b2b; border: 1px solid var(--border-card); color: var(--text-mid);
  display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
}
.task-view { position: relative; }
.task-composer-wrap { padding: 10px 18px 14px; border-top: 1px solid var(--border-soft); }
.task-composer-wrap .composer-card { background: var(--bg-card-outer); border-radius: 12px; padding: 8px 10px 10px; }

/* ---------- P0: context meter, queue, message actions, turn nav, git ---------- */
.ctx-meter {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11px; color: var(--text-faint);
  border: 1px solid var(--border-soft); border-radius: 999px; padding: 1px 8px;
}
.ctx-bar {
  width: 46px; height: 5px; border-radius: 3px; background: #2b2b2b; overflow: hidden;
  display: inline-block;
}
.ctx-bar > span { display: block; height: 100%; background: #4f9e6f; border-radius: 3px; }
.ctx-bar > span.hot { background: #d06a5a; }
.shell[data-theme="light"] .ctx-bar { background: #ddd; }

.queue-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0 2px 8px; }
.queue-label { font-size: 11px; color: var(--text-faint); }
.queue-chip {
  font-size: 11px; color: var(--text-mid);
  background: #232323; border: 1px dashed var(--border-card);
  border-radius: 999px; padding: 2px 10px; max-width: 260px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.msg-actions { display: inline-flex; gap: 2px; margin-left: 6px; opacity: 0; transition: opacity .12s; }
.msg:hover .msg-actions, .msg-meta:hover .msg-actions { opacity: 1; }
.msg-act {
  background: none; border: none; color: var(--text-faint); cursor: pointer;
  font-size: 11px; padding: 0 3px; border-radius: 4px;
}
.msg-act:hover { color: var(--text); background: #2b2b2b; }
.msg-act.on { color: #e0b04c; }

.turn-nav {
  position: absolute; right: 14px; top: 52px; bottom: 130px; z-index: 15;
  display: flex; flex-direction: column; gap: 4px; overflow-y: auto;
  padding: 4px 2px; scrollbar-width: thin;
}
.turn-nav-item {
  max-width: 130px; text-align: left; font-size: 10px; color: var(--text-faint);
  background: #1f1f1f; border: 1px solid var(--border-soft); border-radius: 6px;
  padding: 2px 7px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.turn-nav-item:hover { color: var(--text); border-color: var(--border-card); }

.git-view { display: flex; flex-direction: column; height: 100%; }
.git-branch {
  font-size: 12px; color: #7fb069; border: 1px solid var(--border-soft);
  border-radius: 999px; padding: 1px 10px;
}
.git-body { display: flex; flex: 1; min-height: 0; }
.git-files {
  width: 300px; border-right: 1px solid var(--border-soft); overflow-y: auto; padding: 8px 0;
}
.git-file {
  display: flex; align-items: center; gap: 8px; padding: 5px 14px; cursor: pointer;
  font-size: 12px; color: var(--text-mid);
}
.git-file:hover { background: #1d1d1d; }
.git-file.active { background: #232323; color: var(--text); }
.git-code {
  font-size: 10px; border-radius: 4px; padding: 0 5px; flex: none;
  border: 1px solid var(--border-soft);
}
.gc-m { color: #e0b04c; } .gc-a { color: #7fb069; } .gc-d { color: #d06a5a; }
.gc-u { color: #8a8ad0; } .gc-r, .gc-c { color: #6fb3c9; }
.git-path { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.git-diff { flex: 1; min-width: 0; overflow: auto; display: flex; flex-direction: column; }
.git-diff-head {
  padding: 6px 14px; font-size: 12px; color: var(--text-low);
  border-bottom: 1px solid var(--border-soft); flex: none;
  font-family: ui-monospace, monospace;
}
.diff-pre {
  margin: 0; padding: 8px 0; font-family: ui-monospace, monospace; font-size: 12px;
  flex: 1; overflow: auto;
}
.diff-pre > div { padding: 0 14px; white-space: pre-wrap; word-break: break-all; }
.diff-add { background: rgba(80, 160, 90, .16); color: #9fd6a0; }
.diff-del { background: rgba(200, 80, 70, .16); color: #e6a09a; }
.diff-hunk { color: #6fb3c9; background: rgba(90, 140, 200, .08); }
.diff-ctx { color: var(--text-low); }
.shell[data-theme="light"] .diff-add { color: #1c6b2a; }
.shell[data-theme="light"] .diff-del { color: #a33; }

/* ---------- P1: palette, elicitation, work panel, sidebar groups ---------- */
.overlay-backdrop {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(0,0,0,.55);
  display: flex; justify-content: center; align-items: flex-start; padding-top: 110px;
}
.palette-card { width: 560px; background: #232323; border: 1px solid var(--border-soft); border-radius: 12px; overflow: hidden; }
.palette-list { max-height: 340px; overflow-y: auto; padding: 6px; }
.palette-list .menu-item { display: flex; justify-content: space-between; gap: 10px; }
.palette-list .menu-item em { color: var(--text-faint); font-style: normal; font-size: 11px; }
.palette-list .menu-item.active { background: #333; }
.overlay-input {
  flex: 1; background: transparent; border: none; outline: none;
  color: var(--text); font-size: 13px;
}

.elicitation-card {
  width: 480px; background: #232323; border: 1px solid var(--border-card);
  border-radius: 12px; overflow: hidden; margin-top: 40px;
}
.elicitation-head { padding: 12px 16px; border-bottom: 1px solid var(--border-soft); color: var(--text); font-weight: 600; }
.elicitation-body { padding: 12px 16px; display: flex; flex-direction: column; gap: 12px; max-height: 50vh; overflow-y: auto; }
.elicitation-label { display: flex; flex-direction: column; gap: 2px; color: var(--text-mid); font-size: 12px; margin-bottom: 6px; }
.elicitation-label em { color: var(--text-faint); font-style: normal; font-size: 11px; }
.elicitation-field .overlay-input { background: #2b2b2b; border: 1px solid var(--border-soft); border-radius: 6px; padding: 6px 8px; width: 100%; }
.elicitation-options { display: flex; gap: 6px; flex-wrap: wrap; }
.elicitation-actions { display: flex; justify-content: flex-end; gap: 8px; padding: 12px 16px; border-top: 1px solid var(--border-soft); }
.settings-button.active, .settings-button.primary { border-color: #4f9e6f; color: #9fd6a0; }

.work-panel {
  position: absolute; right: 0; top: 46px; bottom: 0; width: 300px; z-index: 25;
  background: #1d1d1d; border-left: 1px solid var(--border-soft);
  display: flex; flex-direction: column; overflow-y: auto;
}
.work-panel-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10px 14px; color: var(--text); font-weight: 600; font-size: 13px;
  border-bottom: 1px solid var(--border-soft);
}
.work-panel-section { padding: 10px 14px; border-bottom: 1px solid var(--border-soft); }
.work-panel-title { color: var(--text-faint); font-size: 11px; margin-bottom: 6px; }
.todo-row { display: flex; gap: 8px; align-items: baseline; padding: 3px 0; font-size: 12px; color: var(--text-mid); }
.todo-mark { width: 14px; text-align: center; color: var(--text-faint); flex: none; }
.todo-completed { color: var(--text-faint); text-decoration: line-through; }
.todo-in_progress .todo-mark { color: var(--status-awaiting); }
.panel-count { font-style: normal; font-size: 10px; background: #4f9e6f; color: #10231a; border-radius: 8px; padding: 0 5px; margin-left: 4px; }

.group-label {
  padding: 8px 14px 3px; color: var(--text-faint); font-size: 10px;
  display: flex; align-items: center; gap: 5px;
}
.group-label.clickable { cursor: pointer; }
.group-label.clickable:hover { color: var(--text-mid); }
.unread-dot { width: 7px; height: 7px; border-radius: 50%; background: #4f9e6f; flex: none; }

/* ---------- P1: code viewer (line numbers + highlight) ---------- */
.md-code.md-code-lines { padding: 6px 0; }
.code-line { display: flex; gap: 10px; padding: 0 10px; }
.code-line:hover { background: rgba(255,255,255,.03); }
.code-ln {
  flex: none; width: 3ch; text-align: right; color: #555; user-select: none;
  font-size: 11px; line-height: 1.5;
}
.code-src { white-space: pre-wrap; word-break: break-all; line-height: 1.5; }
.tok-c { color: #6a9955; font-style: italic; }
.tok-s { color: #ce9178; }
.tok-n { color: #b5cea8; }
.tok-k { color: #c586c0; }
.shell[data-theme="light"] .tok-c { color: #008000; }
.shell[data-theme="light"] .tok-s { color: #a31515; }
.shell[data-theme="light"] .tok-n { color: #098658; }
.shell[data-theme="light"] .tok-k { color: #af00db; }
.shell[data-theme="light"] .code-ln { color: #aaa; }

/* automation / mcp crud rows */
.crud-form { display: flex; gap: 6px; padding: 10px 14px; flex-wrap: wrap; }
.crud-form .overlay-input { background: #2b2b2b; border: 1px solid var(--border-soft); border-radius: 6px; padding: 5px 8px; }
.crud-row { display: flex; align-items: center; gap: 8px; padding: 7px 14px; color: var(--text-mid); font-size: 12px; }
.crud-row .spacer { flex: 1; }
.crud-error { color: #e6a09a; font-size: 12px; padding: 6px 14px; }
