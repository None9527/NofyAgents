{
  "schema_version": 1,
  "name": "portable-budget",
  "required_governance": [{"id": "quota", "version": "1"}],
  "modules": [
    {"reference": {"id": "ledger", "version": "1"}, "factory": "resource.budget", "config": {}},
    {
      "reference": {"id": "quota", "version": "1"},
      "factory": "governance.budget_connected",
      "config": {"limits": {"max_tool_calls": 2, "max_model_calls": 0}},
      "dependencies": {"budget": {"id": "ledger", "version": "1"}}
    },
    {
      "reference": {"id": "compute", "version": "1"},
      "factory": "tool.rhai",
      "config": {"contract": {"name": "compute"}, "source": "#{result: args.value * 2}"}
    }
  ],
  "programs": {
    "compute": {
      "kind": "tool",
      "definition": {"name": "compute-program", "tool_packs": [{"id": "compute", "version": "1"}]},
      "call": {"id": "compute-root", "name": "compute", "arguments": {"value": 7}}
    },
    "limited_flow": {
      "kind": "workflow",
      "input": {},
      "document": {
        "host": {"name": "limited-flow"},
        "entry": {"id": "main", "version": "1"},
        "tool_runtimes": [{"reference": {"id": "tools", "version": "1"}, "definition": {"name": "tools", "tool_packs": [{"id": "compute", "version": "1"}]}}],
        "workflows": [{
          "reference": {"id": "main", "version": "1"},
          "input_schema": true,
          "output_schema": true,
          "nodes": [
            {"id": "first", "action": {"kind": "tool", "runtime": {"id": "tools", "version": "1"}, "tool": "compute"}, "input": {"from": "literal", "value": {"value": 7}}},
            {"id": "second", "needs": ["first"], "action": {"kind": "tool", "runtime": {"id": "tools", "version": "1"}, "tool": "compute"}, "input": {"from": "literal", "value": {"value": 9}}}
          ],
          "output": {"from": "node", "node": "second"}
        }]
      }
    }
  }
}
