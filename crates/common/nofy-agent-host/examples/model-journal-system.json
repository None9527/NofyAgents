{
  "schema_version": 1,
  "name": "journal-agent",
  "modules": [
    {
      "reference": {
        "id": "provider",
        "version": "1"
      },
      "factory": "resource.sampler",
      "config": {
        "connection": {
          "base_url": "http://127.0.0.1:8000/v1",
          "api_backend": "chat_completions",
          "auth_scheme": "bearer",
          "max_retries": 0,
          "max_completion_tokens": 1024
        },
        "models": [
          "local-model"
        ],
        "credential_ref": "MODEL_TOKEN",
        "request_limits": {
          "local-model": {
            "max_input_tokens": 8192,
            "max_output_tokens": 1024
          }
        }
      }
    },
    {
      "reference": {
        "id": "model",
        "version": "1"
      },
      "factory": "model.connected",
      "config": {
        "model": "local-model"
      },
      "dependencies": {
        "connection": {
          "id": "provider",
          "version": "1"
        }
      }
    },
    {
      "reference": {
        "id": "prompt",
        "version": "1"
      },
      "factory": "prompt.static",
      "config": {
        "text": "Answer clearly. Use compute when asked to double an integer."
      }
    },
    {
      "reference": {
        "id": "compute",
        "version": "1"
      },
      "factory": "tool.rhai",
      "config": {
        "contract": {
          "name": "compute",
          "description": "Double an integer",
          "input_schema": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "source": "#{result: args.value * 2}"
      }
    },
    {
      "reference": {
        "id": "journal",
        "version": "1"
      },
      "factory": "binding.model_journal",
      "config": {}
    }
  ],
  "programs": {
    "chat": {
      "kind": "agent",
      "definition": {
        "name": "recoverable-agent",
        "model": {
          "id": "model",
          "version": "1"
        },
        "prompt": {
          "id": "prompt",
          "version": "1"
        },
        "tool_packs": [
          {
            "id": "compute",
            "version": "1"
          }
        ],
        "bindings": [
          {
            "id": "journal",
            "version": "1"
          }
        ]
      }
    }
  }
}
