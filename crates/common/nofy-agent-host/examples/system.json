{
  "schema_version": 1,
  "name": "portable-assistant",
  "modules": [
    {
      "reference": {"id": "provider", "version": "1"},
      "factory": "resource.sampler",
      "config": {
        "connection": {"base_url": "http://127.0.0.1:8000/v1", "api_backend": "chat_completions", "auth_scheme": "bearer", "max_retries": 0},
        "models": ["local-model"],
        "credential_ref": "MODEL_TOKEN"
      }
    },
    {
      "reference": {"id": "model", "version": "1"},
      "factory": "model.connected",
      "config": {"model": "local-model"},
      "dependencies": {"connection": {"id": "provider", "version": "1"}}
    },
    {
      "reference": {"id": "prompt", "version": "1"},
      "factory": "prompt.static",
      "config": {"text": "You are a helpful assistant. Answer clearly and precisely."}
    }
  ],
  "programs": {
    "chat": {
      "kind": "agent",
      "definition": {
        "name": "assistant",
        "model": {"id": "model", "version": "1"},
        "prompt": {"id": "prompt", "version": "1"}
      }
    }
  }
}
