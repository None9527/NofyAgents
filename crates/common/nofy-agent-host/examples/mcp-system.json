{
  "schema_version": 1,
  "name": "mcp-tools",
  "required_policies": [{"id":"approval","version":"1"}],
  "modules": [
    {
      "reference": {"id":"server","version":"1"},
      "factory": "resource.mcp_http",
      "config": {"endpoint":"http://127.0.0.1:8765/mcp","credential_ref":"MCP_TOKEN"}
    },
    {
      "reference": {"id":"tools","version":"1"},
      "factory": "tool_source.mcp",
      "config": {"namespace":"workspace","allowed_tools":["read_file"]},
      "dependencies": {"connection":{"id":"server","version":"1"}}
    },
    {
      "reference": {"id":"approval","version":"1"},
      "factory": "policy.approval",
      "config": {}
    }
  ],
  "programs": {
    "read": {
      "kind": "tool",
      "definition": {"name":"mcp-read","tool_sources":[{"id":"tools","version":"1"}]},
      "call": {"id":"read-source","name":"workspace_read_file","arguments":{"path":"README.md"}}
    }
  }
}
