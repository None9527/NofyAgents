{
  "schema_version": 1,
  "name": "portable-assistant",
  "modules": [
    {
      "reference": {
        "id": "provider",
        "version": "1"
      },
      "factory": "resource.sampler",
      "config": {
        "connection": {
          "base_url": "http://127.0.0.1:8000/v1",
          "api_backend": "chat_completions",
          "auth_scheme": "bearer",
          "max_retries": 0
        },
        "models": [
          "local-model"
        ],
        "credential_ref": "MODEL_TOKEN"
      }
    },
    {
      "reference": {
        "id": "model",
        "version": "1"
      },
      "factory": "model.connected",
      "config": {
        "model": "local-model"
      },
      "dependencies": {
        "connection": {
          "id": "provider",
          "version": "1"
        }
      }
    },
    {
      "reference": {
        "id": "prompt",
        "version": "1"
      },
      "factory": "prompt.static",
      "config": {
        "text": "You are a helpful assistant. Answer clearly and precisely."
      }
    },
    {
      "reference": {
        "id": "service",
        "version": "1"
      },
      "factory": "resource.http",
      "config": {
        "base_url": "http://127.0.0.1:8001/api/",
        "methods": [
          "POST"
        ],
        "credential_refs": [
          "SERVICE_TOKEN"
        ]
      }
    },
    {
      "reference": {
        "id": "remote-tool",
        "version": "1"
      },
      "factory": "tool.http_connected",
      "config": {
        "contract": {
          "name": "configured_tool",
          "description": "Call the configured external service"
        },
        "path": "tool",
        "method": "POST",
        "credential_ref": "SERVICE_TOKEN"
      },
      "dependencies": {
        "connection": {
          "id": "service",
          "version": "1"
        }
      }
    },
    {
      "reference": {
        "id": "hook-tool",
        "version": "1"
      },
      "factory": "tool.http_connected",
      "config": {
        "contract": {
          "name": "hook_method",
          "description": "Run an external Hook method"
        },
        "path": "hook",
        "method": "POST",
        "credential_ref": "SERVICE_TOKEN"
      },
      "dependencies": {
        "connection": {
          "id": "service",
          "version": "1"
        }
      }
    },
    {
      "reference": {
        "id": "hook-handler",
        "version": "1"
      },
      "factory": "hook.executor",
      "config": {
        "tool": "hook_method"
      },
      "dependencies": {
        "executor": {
          "id": "hook-tool",
          "version": "1"
        }
      }
    },
    {
      "reference": {
        "id": "before-model",
        "version": "1"
      },
      "factory": "hook.subscription",
      "config": {
        "event": "before_model"
      },
      "dependencies": {
        "handler": {
          "id": "hook-handler",
          "version": "1"
        }
      }
    }
  ],
  "programs": {
    "chat": {
      "kind": "agent",
      "definition": {
        "name": "assistant",
        "model": {
          "id": "model",
          "version": "1"
        },
        "prompt": {
          "id": "prompt",
          "version": "1"
        },
        "tool_packs": [
          {
            "id": "remote-tool",
            "version": "1"
          }
        ],
        "hooks": [
          {
            "id": "before-model",
            "version": "1"
          }
        ]
      }
    },
    "do_work": {
      "kind": "tool",
      "definition": {
        "name": "configured-tool-program",
        "tool_packs": [
          {
            "id": "remote-tool",
            "version": "1"
          }
        ]
      },
      "call": {
        "id": "external-effect",
        "name": "configured_tool",
        "arguments": {
          "value": 1
        }
      }
    }
  }
}
