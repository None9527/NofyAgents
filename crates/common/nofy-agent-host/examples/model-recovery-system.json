{
  "schema_version": 1,
  "name": "recoverable-agent",
  "required_governance": [{"id": "quota", "version": "1"}],
  "modules": [
    {
      "reference": {"id": "provider", "version": "1"},
      "factory": "resource.sampler",
      "config": {
        "connection": {"base_url": "http://127.0.0.1:8000/v1", "api_backend": "chat_completions", "auth_scheme": "bearer", "max_retries": 0, "max_completion_tokens": 1024},
        "models": ["local-model"],
        "credential_ref": "MODEL_TOKEN",
        "request_limits": {"local-model": {"max_input_tokens": 8192, "max_output_tokens": 1024}}
      }
    },
    {
      "reference": {"id": "model", "version": "1"},
      "factory": "model.connected",
      "config": {"model": "local-model"},
      "dependencies": {"connection": {"id": "provider", "version": "1"}}
    },
    {"reference": {"id": "prompt", "version": "1"}, "factory": "prompt.static", "config": {"text": "Answer clearly. Use compute when asked to double an integer."}},
    {"reference": {"id": "ledger", "version": "1"}, "factory": "resource.budget", "config": {}},
    {
      "reference": {"id": "quota", "version": "1"},
      "factory": "governance.budget_connected",
      "config": {"limits": {"max_model_calls": 8, "max_tool_calls": 8}},
      "dependencies": {"budget": {"id": "ledger", "version": "1"}}
    },
    {
      "reference": {"id": "compute", "version": "1"},
      "factory": "tool.rhai",
      "config": {
        "contract": {"name": "compute", "description": "Double an integer", "input_schema": {"type": "object", "required": ["value"], "properties": {"value": {"type": "integer"}}, "additionalProperties": false}},
        "source": "#{result: args.value * 2}"
      }
    }
  ],
  "programs": {
    "chat": {
      "kind": "agent",
      "definition": {"name": "recoverable-agent", "model": {"id": "model", "version": "1"}, "prompt": {"id": "prompt", "version": "1"}, "tool_packs": [{"id": "compute", "version": "1"}]}
    }
  }
}
