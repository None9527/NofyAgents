{
  "format": "nofy.module-package/v1",
  "name": "workspace-files",
  "version": "0.2.0",
  "description": "Six bounded workspace file tools plus coding rules and cwd binding, backed by an explicit local process runtime.",
  "parameters_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "When false, emits no modules so presets can toggle workspace access conditionally."
      },
      "workspace": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Absolute workspace root directory."
      },
      "environment": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executable",
              "paths"
            ],
            "properties": {
              "executable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "prefix_args": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "env": {
                "type": "object",
                "maxProperties": 32,
                "additionalProperties": {
                  "type": "string"
                }
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "execute": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Explicit local process runtime configuration for resource.process_local."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "enabled": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "workspace",
            "environment"
          ],
          "properties": {
            "workspace": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": "object"
            }
          }
        }
      }
    ]
  },
  "inputs": {},
  "modules": [
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "rules"
          },
          "factory": "context.rules",
          "config": {
            "files": [
              {
                "file_name": "coding-rules.md",
                "file_path": "/definitions/coding/rules.md",
                "content": {
                  "$file": "rules.md"
                }
              }
            ]
          }
        }
      }
    },
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "cwd"
          },
          "factory": "binding.cwd",
          "config": {
            "cwd": {
              "$parameter": "/workspace"
            }
          }
        }
      }
    },
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "project-read"
          },
          "factory": "resource.directory",
          "config": {
            "path": {
              "$parameter": "/workspace"
            },
            "access": "read_only"
          }
        }
      }
    },
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "project-write"
          },
          "factory": "resource.directory",
          "config": {
            "path": {
              "$parameter": "/workspace"
            },
            "access": "read_write"
          }
        }
      }
    },
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "runtime"
          },
          "factory": "resource.process_local",
          "config": {
            "$parameter": "/environment"
          }
        }
      }
    },
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "files-code"
          },
          "factory": "resource.artifact",
          "config": {
            "bundle": {
              "schema_version": 1,
              "files": {
                "files.py": {
                  "$file": "files.py"
                },
                "workspace.py": {
                  "$file": "workspace.py"
                },
                "manifest.json": {
                  "$file": "manifest.json"
                }
              }
            }
          }
        }
      }
    },
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "file-read"
          },
          "factory": "tool.process_artifact",
          "config": {
            "$json": {
              "path": "manifest.json",
              "pointer": "/tools/read_file"
            }
          },
          "dependencies": {
            "environment": {
              "$module": "runtime"
            },
            "artifact": {
              "$module": "files-code"
            },
            "workspace": {
              "$module": "project-read"
            }
          }
        }
      }
    },
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "file-write"
          },
          "factory": "tool.process_artifact",
          "config": {
            "$json": {
              "path": "manifest.json",
              "pointer": "/tools/write_file"
            }
          },
          "dependencies": {
            "environment": {
              "$module": "runtime"
            },
            "artifact": {
              "$module": "files-code"
            },
            "workspace": {
              "$module": "project-write"
            }
          }
        }
      }
    },
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "file-edit"
          },
          "factory": "tool.process_artifact",
          "config": {
            "$json": {
              "path": "manifest.json",
              "pointer": "/tools/edit_file"
            }
          },
          "dependencies": {
            "environment": {
              "$module": "runtime"
            },
            "artifact": {
              "$module": "files-code"
            },
            "workspace": {
              "$module": "project-write"
            }
          }
        }
      }
    },
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "directory-create"
          },
          "factory": "tool.process_artifact",
          "config": {
            "$json": {
              "path": "manifest.json",
              "pointer": "/tools/make_directory"
            }
          },
          "dependencies": {
            "environment": {
              "$module": "runtime"
            },
            "artifact": {
              "$module": "files-code"
            },
            "workspace": {
              "$module": "project-write"
            }
          }
        }
      }
    },
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "file-list"
          },
          "factory": "tool.process_artifact",
          "config": {
            "$json": {
              "path": "manifest.json",
              "pointer": "/tools/list_files"
            }
          },
          "dependencies": {
            "environment": {
              "$module": "runtime"
            },
            "artifact": {
              "$module": "files-code"
            },
            "workspace": {
              "$module": "project-read"
            }
          }
        }
      }
    },
    {
      "$when": {
        "parameter": "/enabled",
        "value": {
          "reference": {
            "$module": "file-search"
          },
          "factory": "tool.process_artifact",
          "config": {
            "$json": {
              "path": "manifest.json",
              "pointer": "/tools/search_files"
            }
          },
          "dependencies": {
            "environment": {
              "$module": "runtime"
            },
            "artifact": {
              "$module": "files-code"
            },
            "workspace": {
              "$module": "project-read"
            }
          }
        }
      }
    }
  ],
  "exports": {
    "rules": "rules",
    "cwd": "cwd",
    "read": "file-read",
    "write": "file-write",
    "edit": "file-edit",
    "mkdir": "directory-create",
    "list": "file-list",
    "search": "file-search"
  }
}
