{
  "format": "nofy.module-package/v1",
  "name": "main-agent-guardrails",
  "version": "0.1.0",
  "description": "Inherited root tool scope and one shared durable budget ledger.",
  "parameters_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "allowed_tools": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "default": [
          "agent_tasks",
          "task",
          "agent_messages",
          "ask_user",
          "workflow_execute"
        ],
        "description": "Root allow-list inherited by descendants. Adding a tool does not automatically authorize it."
      },
      "budget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max_steps": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "max_model_calls": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "max_tool_calls": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "max_child_calls": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "max_input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "max_output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "max_total_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "max_duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "max_concurrent_operations": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 4294967295
          },
          "max_active_children": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 4294967295
          },
          "max_depth": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "default": {
          "max_model_calls": 64,
          "max_tool_calls": 128,
          "max_child_calls": 8,
          "max_active_children": 4,
          "max_depth": 4
        },
        "description": "Shared root ledger limits. The child does not receive a fresh independent budget."
      }
    }
  },
  "inputs": {},
  "modules": [
    {
      "reference": {
        "$module": "floor"
      },
      "factory": "policy.tool_scope",
      "config": {
        "allowed": {
          "$parameter": "/allowed_tools"
        }
      }
    },
    {
      "reference": {
        "$module": "ledger"
      },
      "factory": "resource.budget",
      "config": {}
    },
    {
      "reference": {
        "$module": "quota"
      },
      "factory": "governance.budget_connected",
      "config": {
        "limits": {
          "$parameter": "/budget"
        }
      },
      "dependencies": {
        "budget": {
          "$module": "ledger"
        }
      }
    }
  ],
  "exports": {
    "floor": "floor",
    "quota": "quota"
  }
}
