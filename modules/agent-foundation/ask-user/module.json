{
  "format": "nofy.module-package/v1",
  "name": "ask-user",
  "version": "0.1.0",
  "description": "Ask a human a question; persist the exact request and accept only a matching run.control Human response.",
  "parameters_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "response_schema": {
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "inputs": {},
  "modules": [
    {
      "reference": {
        "$module": "workflow"
      },
      "factory": "resource.workflow",
      "config": {
        "document": {
          "host": {
            "name": "ask-user-host"
          },
          "entry": {
            "id": "ask",
            "version": "1"
          },
          "workflows": [
            {
              "reference": {
                "id": "ask",
                "version": "1"
              },
              "input_schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question"
                ],
                "properties": {
                  "question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "output_schema": true,
              "nodes": [
                {
                  "id": "answer",
                  "needs": [],
                  "input": {
                    "from": "input",
                    "pointer": ""
                  },
                  "action": {
                    "kind": "human",
                    "response_schema": {
                      "$parameter": "/response_schema"
                    }
                  }
                }
              ],
              "output": {
                "from": "node",
                "node": "answer",
                "pointer": ""
              }
            }
          ]
        },
        "bindings": {}
      },
      "dependencies": {}
    },
    {
      "reference": {
        "$module": "tool"
      },
      "factory": "tool.workflow_connected",
      "config": {
        "name": "ask_user",
        "description": "Ask a human a question; persist the exact request and accept only a matching run.control Human response."
      },
      "dependencies": {
        "workflow": {
          "$module": "workflow"
        }
      }
    }
  ],
  "exports": {
    "tool": "tool"
  }
}
