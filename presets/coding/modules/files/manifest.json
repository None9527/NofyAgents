{
  "schema_version": 1,
  "limits": {
    "max_input_bytes": 2097152,
    "max_output_bytes": 524288,
    "max_file_bytes": 2097152,
    "max_scan_bytes": 33554432,
    "max_entries": 20000,
    "max_depth": 32,
    "max_path_bytes": 4096,
    "result_bytes": 400000
  },
  "ignored_directories": [
    ".git",
    ".hg",
    ".svn",
    "node_modules",
    "target",
    ".venv",
    "__pycache__"
  ],
  "tools": {
    "read_file": {
      "contract": {
        "name": "read_file",
        "description": "Read a bounded UTF-8 byte window and the full-file SHA-256. Offsets must be UTF-8 boundaries; no symlinks. Always inspect ok; a completed root is not proof of a successful file operation.",
        "effect": "read_only",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 4,
              "maximum": 65536,
              "default": 32768
            }
          }
        },
        "output_schema": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "result"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "result": {
                  "type": "object"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "error"
              ],
              "properties": {
                "ok": {
                  "const": false
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "effect"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "effect": {
                      "enum": [
                        "none",
                        "partial",
                        "committed_unconfirmed",
                        "unknown"
                      ]
                    },
                    "created": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "timeout_ms": 30000,
        "max_input_bytes": 2097152,
        "max_output_bytes": 524288
      },
      "entrypoint": "files.py",
      "args": [
        "read_file"
      ],
      "directories": {
        "WORKSPACE": "workspace"
      }
    },
    "write_file": {
      "contract": {
        "name": "write_file",
        "description": "Atomically publish UTF-8 text. expected_sha256 is mandatory: null creates only; an exact digest permits replacement. Parent directories must exist. Always inspect ok; a completed root is not proof of a successful file operation.",
        "effect": "non_idempotent",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "content",
            "expected_sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "content": {
              "type": "string",
              "maxLength": 262144
            },
            "expected_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "output_schema": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "result"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "result": {
                  "type": "object"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "error"
              ],
              "properties": {
                "ok": {
                  "const": false
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "effect"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "effect": {
                      "enum": [
                        "none",
                        "partial",
                        "committed_unconfirmed",
                        "unknown"
                      ]
                    },
                    "created": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "timeout_ms": 30000,
        "max_input_bytes": 2097152,
        "max_output_bytes": 524288
      },
      "entrypoint": "files.py",
      "args": [
        "write_file"
      ],
      "directories": {
        "WORKSPACE": "workspace"
      }
    },
    "edit_file": {
      "contract": {
        "name": "edit_file",
        "description": "Apply ordered exact text replacements to a matching file version. Every replacement must occur exactly expected_count times; no fuzzy edits. Always inspect ok; a completed root is not proof of a successful file operation.",
        "effect": "non_idempotent",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "expected_sha256",
            "edits"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "edits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "old_text",
                  "new_text"
                ],
                "properties": {
                  "old_text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 262144
                  },
                  "new_text": {
                    "type": "string",
                    "maxLength": 262144
                  },
                  "expected_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000,
                    "default": 1
                  }
                }
              }
            }
          }
        },
        "output_schema": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "result"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "result": {
                  "type": "object"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "error"
              ],
              "properties": {
                "ok": {
                  "const": false
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "effect"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "effect": {
                      "enum": [
                        "none",
                        "partial",
                        "committed_unconfirmed",
                        "unknown"
                      ]
                    },
                    "created": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "timeout_ms": 30000,
        "max_input_bytes": 2097152,
        "max_output_bytes": 524288
      },
      "entrypoint": "files.py",
      "args": [
        "edit_file"
      ],
      "directories": {
        "WORKSPACE": "workspace"
      }
    },
    "make_directory": {
      "contract": {
        "name": "make_directory",
        "description": "Create a relative directory tree without following links. Reports every created directory; errors may leave explicitly reported partial directory effects. Always inspect ok; a completed root is not proof of a successful file operation.",
        "effect": "idempotent",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "output_schema": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "result"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "result": {
                  "type": "object"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "error"
              ],
              "properties": {
                "ok": {
                  "const": false
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "effect"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "effect": {
                      "enum": [
                        "none",
                        "partial",
                        "committed_unconfirmed",
                        "unknown"
                      ]
                    },
                    "created": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "timeout_ms": 30000,
        "max_input_bytes": 2097152,
        "max_output_bytes": 524288
      },
      "entrypoint": "files.py",
      "args": [
        "make_directory"
      ],
      "directories": {
        "WORKSPACE": "workspace"
      }
    },
    "list_files": {
      "contract": {
        "name": "list_files",
        "description": "List bounded relative files/directories. Hidden entries are excluded by default. Traversal skips links/special files and reports all limits/skips. Always inspect ok; a completed root is not proof of a successful file operation.",
        "effect": "read_only",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "default": "."
            },
            "include_hidden": {
              "type": "boolean",
              "default": false
            },
            "max_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32,
              "default": 12
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 200
            }
          }
        },
        "output_schema": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "result"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "result": {
                  "type": "object"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "error"
              ],
              "properties": {
                "ok": {
                  "const": false
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "effect"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "effect": {
                      "enum": [
                        "none",
                        "partial",
                        "committed_unconfirmed",
                        "unknown"
                      ]
                    },
                    "created": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "timeout_ms": 30000,
        "max_input_bytes": 2097152,
        "max_output_bytes": 524288
      },
      "entrypoint": "files.py",
      "args": [
        "list_files"
      ],
      "directories": {
        "WORKSPACE": "workspace"
      }
    },
    "search_files": {
      "contract": {
        "name": "search_files",
        "description": "Search bounded UTF-8 files by literal text or line-oriented regex. file_glob matches basenames. Results and skipped/truncated scans are explicit; regex is subject to process limits. Always inspect ok; a completed root is not proof of a successful file operation.",
        "effect": "read_only",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "default": "."
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "regex": {
              "type": "boolean",
              "default": false
            },
            "case_sensitive": {
              "type": "boolean",
              "default": true
            },
            "file_glob": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "default": "*"
            },
            "include_hidden": {
              "type": "boolean",
              "default": false
            },
            "max_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32,
              "default": 12
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          }
        },
        "output_schema": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "result"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "result": {
                  "type": "object"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "error"
              ],
              "properties": {
                "ok": {
                  "const": false
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "effect"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "effect": {
                      "enum": [
                        "none",
                        "partial",
                        "committed_unconfirmed",
                        "unknown"
                      ]
                    },
                    "created": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "timeout_ms": 30000,
        "max_input_bytes": 2097152,
        "max_output_bytes": 524288
      },
      "entrypoint": "files.py",
      "args": [
        "search_files"
      ],
      "directories": {
        "WORKSPACE": "workspace"
      }
    }
  }
}
