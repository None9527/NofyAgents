{
  "schema_version": 1,
  "tool": {
    "contract": {
      "name": "run_command",
      "description": "Run one non-interactive argv command in the declared project and locked image. No implicit shell, network or background job. Inspect ok, exit_code, truncation and effect; completion alone is not command success. Failed or cancelled commands may have changed files; reconcile before retrying.",
      "effect": "non_idempotent",
      "input_schema": {
        "type": "object", "additionalProperties": false, "required": ["argv"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "maxLength": 4096}},
          "cwd": {"type": "string", "minLength": 1, "maxLength": 4096, "default": "."},
          "stdin": {"type": "string", "maxLength": 65536, "default": ""},
          "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 300000, "default": 60000},
          "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 262144, "default": 65536}
        }
      },
      "output_schema": {
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["ok", "result"],
           "properties": {"ok": {"const": true}, "result": {"type": "object"}}},
          {"type": "object", "additionalProperties": false, "required": ["ok", "error"],
           "properties": {"ok": {"const": false}, "error": {
             "type": "object", "additionalProperties": false, "required": ["code", "message", "effect"],
             "properties": {"code": {"type": "string"}, "message": {"type": "string"},
               "effect": {"enum": ["none", "unknown"]}, "result": {"type": "object"}}
           }}}
        ]
      },
      "timeout_ms": 330000,
      "max_input_bytes": 262144,
      "max_output_bytes": 2097152
    },
    "entrypoint": "command.py",
    "directories": {"WORKSPACE": "workspace"}
  }
}
