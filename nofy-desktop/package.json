{
  "name": "nofy-desktop-root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "pnpm --filter @nofy-desktop/acp gen",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke": "pnpm --filter @nofy-desktop/app smoke",
    "smoke:real": "pnpm --filter @nofy-desktop/app smoke:real",
    "smoke:recovery": "pnpm --filter @nofy-desktop/app smoke:recovery",
    "smoke:pty": "pnpm --filter @nofy-desktop/app smoke:pty",
    "record": "pnpm --filter @nofy-desktop/app record",
    "audit:fixtures": "pnpm --filter @nofy-desktop/app audit:fixtures",
    "tokens": "pnpm --filter @nofy-desktop/app tokens",
    "build": "pnpm --filter @nofy-desktop/app build",
    "dev": "pnpm --filter @nofy-desktop/app dev",
    "start": "pnpm --filter @nofy-desktop/app start",
    "verify": "pnpm gen && pnpm architecture:check && pnpm ui:check && pnpm typecheck && pnpm test && pnpm audit:fixtures && pnpm build && pnpm smoke && pnpm smoke:pty && pnpm smoke:recovery",
    "package:mac": "pnpm --filter @nofy-desktop/app package:mac",
    "verify:package": "pnpm --filter @nofy-desktop/app verify:package",
    "ui:check": "pnpm --filter @nofy-desktop/app ui:check",
    "architecture:check": "pnpm --filter @nofy-desktop/app architecture:check",
    "architecture:report": "pnpm --filter @nofy-desktop/app architecture:report",
    "verify:performance": "pnpm build && node scripts/verify-conversation-performance.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
